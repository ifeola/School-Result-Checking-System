# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Legacy individual connection variables are still read by some tooling.
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=

# Auth (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
JWT_ISSUER=school-result-checking-system
JWT_AUDIENCE=school-result-checking-system-web
BCRYPT_ROUNDS=12

# Cookies
# COOKIE_SECURE defaults to true in production. Keep true for HTTPS.
COOKIE_SECURE=false
# lax is correct for localhost (different port = same site). Use none only
# when the frontend and API are on different sites and HTTPS is enforced.
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=.example.com

# CORS: comma-separated exact origins, no wildcard, no trailing slash.
CORS_ORIGINS=http://localhost:5173
# false in local dev; set to the number of trusted reverse proxies in prod
# (usually 1 behind Nginx/a single PaaS router).
TRUST_PROXY=false

# Request body limits
JSON_BODY_LIMIT=100kb
URLENCODED_BODY_LIMIT=100kb
URLENCODED_PARAMETER_LIMIT=100

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=7
EXPENSIVE_RATE_LIMIT_WINDOW_MS=900000
EXPENSIVE_RATE_LIMIT_MAX=20
# memory is the only store implemented today; see src/middlewares/rateLimit.ts
RATE_LIMIT_STORE=memory

# Optional login slow-down (adds delay after repeated attempts)
LOGIN_SLOWDOWN_ENABLED=true
LOGIN_SLOWDOWN_WINDOW_MS=900000
LOGIN_SLOWDOWN_DELAY_AFTER=3
LOGIN_SLOWDOWN_DELAY_MS=500
LOGIN_SLOWDOWN_MAX_DELAY_MS=5000

# Puppeteer / PDF generation
# Set true only in a container that cannot run Chromium's sandbox.
PUPPETEER_NO_SANDBOX=false

# Logger
LOG_ENV=development
